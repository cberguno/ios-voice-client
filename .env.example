# Server environment for the Vercel voice route (app/api/voice).
# Copy to .env.local for `next dev`. Set the same names in the Vercel project.
# Never commit real keys. .env and .env*.local are gitignored.

# Shared secret the iPhone sends as x-api-key (VoiceWorkflowKey).
# Compared in constant time. If this is unset or blank, POST /api/voice
# fails closed with 503 and does not call OpenRouter or ElevenLabs.
VOICE_WORKFLOW_KEY=

# OpenRouter key for model z-ai/glm-5.3-flash. Sent as Authorization: Bearer.
OPENROUTER_API_KEY=

# ElevenLabs key. Sent as the xi-api-key header.
ELEVENLABS_API_KEY=

# Optional ElevenLabs voice id (path segment, not the model id).
# Leave empty to use the stock voice Roger (CwhRBWXzGAHq8TQ4Fs17),
# the premade voice HANDOFF.md verified on the free tier.
# SPEC.md also names Rachel (21m00Tcm4TlvDq8ikWAM).
ELEVENLABS_VOICE_ID=
